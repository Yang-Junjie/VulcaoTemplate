{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang",
      "inherits": "base",
      "displayName": "Clang (PATH) + Ninja",
      "description": "Uses clang-cl from PATH (C:/LLVM/bin). clang-cl auto-detects the MSVC toolchain from the registry, so no vcvars is required.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang",
      "displayName": "Clang + Ninja (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "inherits": "clang",
      "displayName": "Clang + Ninja (RelWithDebInfo)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-linux",
      "inherits": "base",
      "hidden": true,
      "displayName": "Clang + Ninja (Linux)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-linux-debug",
      "inherits": "clang-linux",
      "displayName": "Clang + Ninja (Linux Debug)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-linux-release",
      "inherits": "clang-linux",
      "displayName": "Clang + Ninja (Linux RelWithDebInfo)",
      "binaryDir": "${sourceDir}/build-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "msvc",
      "inherits": "base",
      "displayName": "MSVC (Visual Studio 18 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vs-clangcl",
      "inherits": "base",
      "displayName": "MSVC + bundled ClangCL (VS toolset)",
      "generator": "Visual Studio 18 2026",
      "toolset": "ClangCL",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-linux-debug",
      "configurePreset": "clang-linux-debug"
    },
    {
      "name": "clang-linux-release",
      "configurePreset": "clang-linux-release"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "vs-clangcl",
      "configurePreset": "vs-clangcl",
      "configuration": "Debug"
    }
  ]
}
